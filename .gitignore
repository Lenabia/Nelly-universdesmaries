# Fichier .gitignore - Protection des données sensibles
# =========================================================

# 🔒 Configuration sensible (NE JAMAIS COMMITER)
config.php

# 🗄️ Fichiers de base de données
*.sql
*.db
*.sqlite
*.sqlite3

# 📝 Logs et erreurs
*.log
error_log
debug.log
access.log

# 🗂️ Fichiers temporaires
*.tmp
*.temp
*.cache
*.bak
*.backup

# 🖥️ Fichiers système
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 📁 Dossiers de cache et temporaires
cache/
tmp/
temp/
logs/

# 🔐 Fichiers d'environnement
.env
.env.local
.env.production
.env.development

# 📦 Dépendances (si vous utilisez Composer)
vendor/
composer.lock

# 🎨 Fichiers de build et compilation
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 📱 Fichiers de développement
*.swp
*.swo
*~
.vscode/
.idea/

# 🚀 Fichiers de déploiement
deploy.sh
deploy/
production/

# 📊 Fichiers de statistiques
analytics/
stats/

# 🔄 Fichiers de sauvegarde
backup/
backups/
*.backup
